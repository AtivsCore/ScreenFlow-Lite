# See https://help.github.com/articles/ignoring-files/ for more information about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# pasta antiga (remova localmente quando o dev server liberar DLLs bloqueadas)
/screenflow-lite/

# typescript
*.tsbuildinfo
next-env.d.ts

# electron desktop (artefatos locais; instalador publicado em public/downloads/)
desktop-app/node_modules/
desktop-app/dist/
